{
  "compilerOptions": {
    "target": "ESNext",
    "allowJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@src/*": [
        "./app/src/*"
      ],
      "@assets/*": [
        "./app/assets/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "app/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}